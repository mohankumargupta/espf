======================================================================================
ESPF file format

1. ESPF document
   - contain sections, each section contains zero or more elements
   - mandatory sections: espforge, peripherals, components, devices, services
   - sections contain zero or more elements 
2. sections must start with the # character, must be a single line
3. element
   - uses xml self-closing tag syntax
   - consists of name and zero or more attributes
   - multiline is supported, \ continuation not supported
4. element attributes
   - key value pair
   - a nested attribute has the key dotted (eg. wifi below)
   - values always strings enclosed in double quotes
   - except an array value uses += after key, including first element of array (eg. ntp below)
   - double quoted strings cannot span multiple lines
   - single quotes can only appear inside double quotes
5. block comments
   - Must be enclosed between two lines containing only one or more '=' characters.
   - Allowed only directly preceding a section 
   inline comments
   - at the end of element self-closing tag only
   - starts with //
6. you can reference elements by its id attribute 
   throughout the document with the $ character 

======================================================================================

# espforge
  <project name="example project" description="example showing espf file format" />
  <chip type="esp32c3" />
  <runtime type="blocking" />

# peripherals
  <gpio id="gpio4" pin="4" />
  <gpio id="gpio5" pin="5" />
  <i2c  id="i2c0" sda="8" scl="9" frequency="400kHz" />
  <spi  id="spi2" sclk="6" mosi="7" /> // displays generally omit miso
  <uart id="uart1" tx="20" rx="21" />

# components
  <gpio_component id="blue_led"    gpio="$gpio4" direction="output" />
  <i2c_component  id="temp_bus"    i2c="$i2c0" address="0x48" />
  <spi_component  id="display_bus" spi="$spi2" mode="0" cs="gpio5" frequency="40MHz" />
  <uart_component id="serial_bus"  uart="$uart1" baud_rate="9600" parity="none" stop_bits="1" />

# devices
  <status_led     id="status"       gpio_component="$blue_led" />
  <tmp102         id="outdoor_temp" i2c_component="$temp_bus" />
  <ili9341        id="tft_display"  
                  spi_component="$display_bus" />

# services
  <wifi id="wifi"
      network1.ssid="boo" network1.password="123" 
      network2.ssid="moo" network2.password="" />
  <ntp id="ntp"
       timezone="Melbourne/Australia"
       servers+="0.pool.ntp.org"
       servers+="1.pool.ntp.org"
       servers+="0.pool.ntp.org"/>

